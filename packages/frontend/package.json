{
	"name": "@michaelcuneo/seo-genius",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@aws-sdk/client-comprehend": "^3.916.0",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@fontsource/cantarell": "^5.2.8",
		"@fontsource/fjalla-one": "^5.2.7",
		"@fortawesome/fontawesome-svg-core": "^7.1.0",
		"@fortawesome/free-brands-svg-icons": "^7.1.0",
		"@fortawesome/svelte-fontawesome": "^0.2.4",
		"@lucide/svelte": "^0.548.0",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@types/aws-lambda": "^8.10.156",
		"@types/node": "^22",
		"aws-lambda": "^1.0.7",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"highlight.js": "^11.11.1",
		"marked": "^16.4.1",
		"marked-highlight": "^2.2.2",
		"openai": "^6.6.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.13",
		"reset.css": "^2.0.2",
		"sanitize.css": "^13.0.0",
		"stylelint": "^16.25.0",
		"stylelint-config-tailwindcss": "^1.0.0",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"svelte-clerk": "^0.20.1",
		"svelte-kit-sst": "^2.43.5",
		"text-readability": "^1.1.1",
		"tsx": "^4.20.6",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1",
		"vite": "^7.1.7"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@tailwindcss/vite": "^4.1.16",
		"tailwindcss": "^4.1.16"
	}
}
